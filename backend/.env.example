# AI 智库机器人
# 从 https://open.bigmodel.cn/ 获取,glm-4-flash 免费
ZHIPUAI_API_KEY=your_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# 服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS(逗号分隔,生产填前端域名,本地开发用 *)
ALLOWED_ORIGINS=*

# HTTP Basic Auth(防 Render 公开 URL 被滥用)
# ⚠️ 默认密码是 config.py 里的 32 位随机串,生产环境**必须**在 Render Dashboard 覆盖
# 本地开发如需自定义,取消下面注释(留空则用 config.py 默认值)
# DEMO_USERNAME=demo
# DEMO_PASSWORD=your_long_random_password_here

# Embedding 模型(已改用智谱 embedding-2 API,无需本地下载)
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
